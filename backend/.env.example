# Backend Environment Variables
# Copy this file to .env.development, .env.staging, and .env.production
# Then fill in your actual values

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
API_PREFIX=/api/v1
LOG_LEVEL=debug

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kugoo_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRE=30d

# OTP Configuration
OTP_EXPIRY=600 # 10 minutes in seconds
OTP_ATTEMPTS=5

# Password Reset
PASSWORD_RESET_EXPIRY=1800 # 30 minutes

# ============================================
# FIREBASE AUTHENTICATION
# ============================================
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key_here
FIREBASE_CLIENT_EMAIL=your_firebase_client_email@firebase.gserviceaccount.com
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# ============================================
# PAYMENT GATEWAY CONFIGURATION
# ============================================

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# Flutterwave
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your_flutterwave_secret_key
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your_flutterwave_public_key
FLUTTERWAVE_WEBHOOK_SECRET=your_flutterwave_webhook_secret

# Korapay
KORAPAY_SECRET_KEY=your_korapay_secret_key_here
KORAPAY_PUBLIC_KEY=your_korapay_public_key_here
KORAPAY_WEBHOOK_SECRET=your_korapay_webhook_secret

# Payment Configuration
PAYMENT_CURRENCY=NGN
PAYMENT_TIMEOUT=30 # minutes
TRANSACTION_FEE_PERCENTAGE=2.5

# ============================================
# GOOGLE SERVICES
# ============================================

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_MAPS_SECRET_KEY=your_google_maps_secret_key_here

# Distance Matrix Calculation
DISTANCE_MATRIX_TIMEOUT=10000 # milliseconds
MAX_DELIVERY_DISTANCE=50 # kilometers

# ============================================
# AI SERVICES (OpenAI for Zaam)
# ============================================
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_ORG_ID=org-your_organization_id
OPENAI_MODEL=gpt-4
OPENAI_TIMEOUT=30000 # milliseconds

# AI Configuration
AI_RECOMMENDATIONS_ENABLED=true
AI_MAX_TOKENS=500
AI_TEMPERATURE=0.7

# ============================================
# WHATSAPP BUSINESS API
# ============================================
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_API_VERSION=v17.0
WHATSAPP_ENABLED=true

# ============================================
# EMAIL SERVICE (SendGrid)
# ============================================
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@kugoo.app
SENDGRID_FROM_NAME=Kugoo
SENDGRID_REPLY_TO=support@kugoo.app

# Email Templates
EMAIL_VERIFICATION_TEMPLATE_ID=d-your_verification_template_id
ORDER_CONFIRMATION_TEMPLATE_ID=d-your_order_confirmation_template_id
ORDER_READY_TEMPLATE_ID=d-your_order_ready_template_id
ORDER_DELIVERED_TEMPLATE_ID=d-your_order_delivered_template_id
WELCOME_EMAIL_TEMPLATE_ID=d-your_welcome_template_id

# ============================================
# SMS SERVICE (Twilio)
# ============================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_ENABLED=true

# SMS Configuration
SMS_VERIFICATION_ENABLED=true
SMS_ORDER_UPDATES_ENABLED=true

# ============================================
# FILE STORAGE (Supabase or AWS S3)
# ============================================

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key
SUPABASE_BUCKET_NAME=kugoo-storage

# AWS S3 (Alternative)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=kugoo-app-storage-dev
AWS_REGION=us-east-1
AWS_S3_CUSTOM_DOMAIN=https://cdn.kugoo.app

# File Upload Configuration
MAX_UPLOAD_SIZE=52428800 # 50MB in bytes
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,gif,webp
ALLOWED_DOCUMENT_FORMATS=pdf,doc,docx

# ============================================
# ERROR TRACKING & MONITORING (Sentry)
# ============================================
SENTRY_DSN=https://your_sentry_dsn@sentry.io/your_project_id
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILE_SAMPLE_RATE=0.1

# ============================================
# NOTIFICATION SERVICE (Firebase Cloud Messaging)
# ============================================
FCM_SERVER_KEY=your_firebase_cloud_messaging_server_key
FCM_SENDER_ID=your_firebase_sender_id

# Notification Configuration
PUSH_NOTIFICATIONS_ENABLED=true
EMAIL_NOTIFICATIONS_ENABLED=true
SMS_NOTIFICATIONS_ENABLED=true
WHATSAPP_NOTIFICATIONS_ENABLED=true

# ============================================
# PLATFORM CONFIGURATION
# ============================================

# Commission Rates (percentages)
MERCHANT_COMMISSION_RATE=15 # Platform takes 15% from merchant
RIDER_COMMISSION_RATE=5 # Platform takes 5% from rider payment
PLATFORM_COMMISSION_RATE=100 # Merchant pays 15%, Rider takes 85%

# Delivery Configuration
MINIMUM_ORDER_VALUE=500 # in NGN
DELIVERY_BASE_FEE=1000 # in NGN
DELIVERY_PER_KM_RATE=100 # per kilometer
ESTIMATED_DELIVERY_TIME=30 # minutes

# Rider Assignment
AUTO_ASSIGN_RIDERS=true
RIDER_SEARCH_RADIUS=5 # kilometers
RIDER_ASSIGNMENT_TIMEOUT=60 # seconds

# Order Configuration
ORDER_EXPIRY_TIME=300 # 5 minutes - Order auto-cancelled if not accepted
MERCHANT_ACCEPT_TIMEOUT=300 # 5 minutes

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_AI_RECOMMENDATIONS=true
FEATURE_WHATSAPP_BOT=true
FEATURE_ANALYTICS=true
FEATURE_LOYALTY_PROGRAM=false
FEATURE_SCHEDULED_ORDERS=true
FEATURE_GROUP_ORDERS=true
FEATURE_PROMO_CODES=true

# ============================================
# ADMIN CREDENTIALS (Development Only!)
# ============================================
ADMIN_EMAIL=admin@kugoo.app
ADMIN_PASSWORD=Admin@123456 # CHANGE THIS IN PRODUCTION!
ADMIN_PHONE=+2348000000000

# ============================================
# CORS & SECURITY
# ============================================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW=15 # minutes
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# ============================================
# LOGGING & DEBUGGING
# ============================================
LOG_FORMAT=combined # combined, short, tiny, dev
LOG_SQL_QUERIES=true # Log all SQL queries (development only!)
DEBUG_MODE=true

# ============================================
# CACHING
# ============================================
CACHE_DEFAULT_TTL=300 # 5 minutes
CACHE_RESTAURANT_TTL=3600 # 1 hour
CACHE_USER_TTL=600 # 10 minutes

# ============================================
# SCHEDULED JOBS & CRON
# ============================================
ENABLE_CRON_JOBS=true
CLEANUP_ABANDONED_ORDERS_INTERVAL=3600 # 1 hour
CALCULATE_ANALYTICS_INTERVAL=86400 # 1 day

# ============================================
# EXTERNAL SERVICES
# ============================================

# Analytics Service
ANALYTICS_SERVICE_ENABLED=true
ANALYTICS_API_KEY=your_analytics_api_key

# Image Recognition (for menu items)
IMAGE_RECOGNITION_ENABLED=false
CLARIFAI_API_KEY=your_clarifai_api_key

# ============================================
# APP STORE & GOOGLE PLAY
# ============================================
APP_STORE_APP_ID=your_app_store_app_id
GOOGLE_PLAY_APP_ID=com.kugoo.food
APP_VERSION=1.0.0
BUNDLE_ID=com.kugoo.food